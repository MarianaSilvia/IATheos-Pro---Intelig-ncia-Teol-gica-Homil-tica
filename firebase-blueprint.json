{
  "version": 2,
  "runtime": "Firebase emulators / local Express",
  "database": "Firestore",
  "identity": "Firebase Auth UID and admin custom claim",
  "collections": [
    "users/{uid}",
    "users/{uid}/studies/{id}",
    "users/{uid}/notes/{id}",
    "users/{uid}/reading/{chapterKey}",
    "users/{uid}/entitlements/{productId}",
    "users/{uid}/events/{id}",
    "subscriptions/{uid}",
    "products/{id}",
    "adminAudit/{id}",
    "aiLimits/{uid}"
  ],
  "validation": "src/shared/contracts.ts",
  "paymentsEnabled": false,
  "note": "Design reference only. Does not provision or migrate cloud resources. See README.md."
}
