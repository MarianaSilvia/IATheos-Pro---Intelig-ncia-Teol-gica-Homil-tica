# Local-only defaults. Start npm run emulators in another terminal.
USE_FIREBASE_EMULATORS=true
VITE_USE_FIREBASE_EMULATORS=true
PORT=3000
# Optional: real Gemini calls incur provider usage; tests use mocks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Remote access is deliberately disabled. No service account keys in source.
ALLOW_REMOTE_FIREBASE=false
VITE_ALLOW_REMOTE_FIREBASE=false
# Future remote target (verify edition/database before enabling):
FIREBASE_PROJECT_ID=possible-zephyr-zxctm
FIRESTORE_DATABASE_ID=ai-studio-iatheosprointeli-6684e688-953f-4a8e-817e-4611e2daeff1
FIREBASE_STORAGE_BUCKET=possible-zephyr-zxctm.firebasestorage.app
