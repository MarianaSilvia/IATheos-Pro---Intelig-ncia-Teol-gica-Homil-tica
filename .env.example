# Local: npm run supabase:start; copy URL/publishable key from Supabase CLI output.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
ALLOW_REMOTE_SUPABASE=false
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_APP_URL=http://localhost:3000
# Server only. Needed for AI generation records and first-admin command. Never VITE_.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
# Local development uses 127.0.0.1; production defaults to 0.0.0.0 unless HOST is set.
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
# Vercel production value: https://ia-theos-pro-intelig-ncia-teol-gica.vercel.app
# Keep this aligned with the public deployment so payment redirects and
# InfinitePay webhooks point to the deployed API.
# InfinitePay: configure only in the hosting secret manager. Never use VITE_ here.
INFINITEPAY_API_KEY=
INFINITEPAY_HANDLE=
INFINITEPAY_WEBHOOK_SECRET=

# Vercel build-time public configuration (safe to expose in the browser).
# These must match the server-side Supabase URL and publishable key.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Production email/passwordless auth is configured in Supabase Auth SMTP settings.
