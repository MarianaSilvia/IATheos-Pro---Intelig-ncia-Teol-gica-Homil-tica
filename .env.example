# Local: npm run supabase:start; copy URL/publishable key from Supabase CLI output.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
ALLOW_REMOTE_SUPABASE=false
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed for AI generation records and first-admin command. Never VITE_.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
